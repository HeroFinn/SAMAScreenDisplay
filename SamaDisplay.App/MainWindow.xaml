<Window x:Class="SamaDisplay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SAMA Display" Width="1100" Height="700" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Background" Value="#223049"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TitleButton" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D2738"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#0C111A">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Border Width="24" Height="24" CornerRadius="7" Background="{StaticResource Accent}">
                    <TextBlock Text="S" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="SAMA Display" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <Border Background="#16202F" CornerRadius="10" Padding="9,4" Margin="16,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Bad}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TitleStatusText" Text="未连接" FontSize="11" Foreground="{StaticResource Muted}" Margin="7,0,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                <Button x:Name="BtnMin" Style="{StaticResource TitleButton}" Content="—" Click="BtnMin_Click"/>
                <Button x:Name="BtnMax" Style="{StaticResource TitleButton}" Content="□" Click="BtnMax_Click"/>
                <Button x:Name="BtnClose" Style="{StaticResource TitleButton}" Content="✕" Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0C111A" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="12,18,12,8">
                        <TextBlock Text="控制台" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="14,0,0,8"/>
                        <RadioButton x:Name="NavDashboard" Style="{StaticResource NavButton}" GroupName="Nav" IsChecked="True" Content="仪表盘" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavDisplay" Style="{StaticResource NavButton}" GroupName="Nav" Content="显示与主题" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" GroupName="Nav" Content="服务与设置" Checked="Nav_Checked"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="12,8,12,8">
                        <TextBlock Text="设备" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="14,8,0,8"/>
                        <Border Style="{StaticResource Card}" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="SideDot" Width="8" Height="8" Fill="{StaticResource Bad}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SideDeviceText" Text="SAMA 3.4&quot; LCD" FontSize="13" FontWeight="SemiBold" Margin="7,0,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="SidePortText" Text="端口 --" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                                <TextBlock x:Name="SideVersionText" Text="固件 --" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                                <TextBlock x:Name="ModeText" Text="本地模式" Style="{StaticResource Caption}" Margin="0,10,0,0" Foreground="{StaticResource Accent2}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="18,0,18,14">
                        <TextBlock Text="SAMA Display · v1.0" FontSize="11" Foreground="{StaticResource Muted}"/>
                        <TextBlock Text="原生 WPF · 无第三方 UI" FontSize="10" Foreground="#5D6B80" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="22,18,22,18">
                <!-- Dashboard -->
                <Grid x:Name="PageDashboard">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <StackPanel>
                            <TextBlock Text="仪表盘" Style="{StaticResource H1}"/>
                            <TextBlock Text="实时硬件状态会渲染到水冷屏，默认每 3 秒刷新一次。" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button x:Name="BtnToggle" Style="{StaticResource PrimaryButton}" Content="启动显示" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnToggle_Click"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="390"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="屏幕预览" Style="{StaticResource H2}" Margin="2,0,0,8"/>
                                <Border Grid.Row="1" Background="#05080D" CornerRadius="10">
                                    <Image x:Name="PreviewImage" Stretch="Uniform" Margin="6"/>
                                </Border>
                                <Grid Grid.Row="2" Margin="2,10,2,0">
                                    <TextBlock x:Name="FramesText" Text="已发送 0 帧" Style="{StaticResource Caption}"/>
                                    <TextBlock x:Name="FrameMsText" Text="-- ms" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource Card}" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="CPU" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                                        <TextBlock x:Name="CpuNameText" Text="CPU" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        <ProgressBar x:Name="CpuBar" Margin="0,10,0,0" Foreground="{StaticResource Accent}" Maximum="100"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <StackPanel Width="92"><TextBlock Text="负载" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="CpuLoadText" Text="--%" Style="{StaticResource MetricValue}"/></StackPanel>
                                            <StackPanel Width="92"><TextBlock Text="频率" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="CpuClockText" Text="--" Style="{StaticResource MetricValue}"/></StackPanel>
                                            <StackPanel Width="82"><TextBlock Text="功耗" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="CpuPowerText" Text="--" Style="{StaticResource MetricValue}"/></StackPanel>
                                            <StackPanel><TextBlock Text="风扇" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="CpuFanText" Text="--" Style="{StaticResource MetricValue}"/></StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="10,0,0,0">
                                        <TextBlock Text="温度" Style="{StaticResource MetricLabel}" HorizontalAlignment="Right"/>
                                        <TextBlock x:Name="CpuTempText" Text="--°" FontSize="30" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="GPU" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent2}"/>
                                        <TextBlock x:Name="GpuNameText" Text="GPU" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        <ProgressBar x:Name="GpuBar" Margin="0,10,0,0" Foreground="{StaticResource Accent2}" Maximum="100"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <StackPanel Width="92"><TextBlock Text="负载" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="GpuLoadText" Text="--%" Style="{StaticResource MetricValue}"/></StackPanel>
                                            <StackPanel Width="92"><TextBlock Text="频率" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="GpuClockText" Text="--" Style="{StaticResource MetricValue}"/></StackPanel>
                                            <StackPanel Width="92"><TextBlock Text="风扇" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="GpuFanText" Text="--" Style="{StaticResource MetricValue}"/></StackPanel>
                                            <StackPanel><TextBlock Text="显存" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="GpuVramText" Text="--" Style="{StaticResource MetricValue}"/></StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="10,0,0,0">
                                        <TextBlock Text="温度" Style="{StaticResource MetricLabel}" HorizontalAlignment="Right"/>
                                        <TextBlock x:Name="GpuTempText" Text="--°" FontSize="30" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="MEMORY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Good}"/>
                                        <TextBlock x:Name="RamNameText" Text="内存" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                        <ProgressBar x:Name="RamBar" Margin="0,10,0,0" Foreground="{StaticResource Good}" Maximum="100"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <StackPanel Width="112"><TextBlock Text="已用" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="RamUsedText" Text="-- GB" Style="{StaticResource MetricValue}"/></StackPanel>
                                            <StackPanel Width="112"><TextBlock Text="总计" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="RamTotalText" Text="-- GB" Style="{StaticResource MetricValue}"/></StackPanel>
                                            <StackPanel><TextBlock Text="可用" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="RamFreeText" Text="-- GB" Style="{StaticResource MetricValue}"/></StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="10,0,0,0">
                                        <TextBlock Text="占用" Style="{StaticResource MetricLabel}" HorizontalAlignment="Right"/>
                                        <TextBlock x:Name="RamPercentText" Text="--%" FontSize="30" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="4" Style="{StaticResource Card}" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <Grid>
                                    <TextBlock Text="亮度" Style="{StaticResource H2}"/>
                                    <TextBlock x:Name="BrightnessValueText" Text="170" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="255" Value="170" Margin="0,2,0,0" ValueChanged="BrightnessSlider_ValueChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,20,0">
                                <Grid>
                                    <TextBlock Text="刷新间隔" Style="{StaticResource H2}"/>
                                    <TextBlock x:Name="IntervalValueText" Text="3 秒" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="IntervalSlider" Minimum="1" Maximum="10" Value="3" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,2,0,0" ValueChanged="IntervalSlider_ValueChanged"/>
                            </StackPanel>
                            <Button x:Name="BtnStop" Style="{StaticResource GhostButton}" Content="停止画面" VerticalAlignment="Bottom" Click="BtnStop_Click"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Display -->
                <ScrollViewer x:Name="PageDisplay" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="显示与主题" Style="{StaticResource H1}"/>
                        <TextBlock Text="亮度、刷新频率与配色会立即写入服务配置。" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="390"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <TextBlock Text="480 × 480 实时预览" Style="{StaticResource H2}" Margin="2,0,0,8"/>
                                    <Border Grid.Row="1" Background="#05080D" CornerRadius="10">
                                        <Image x:Name="PreviewImageLarge" Stretch="Uniform" Margin="6"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="主题配色" Style="{StaticResource H2}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <RadioButton x:Name="ThemeDark" Style="{StaticResource Pill}" GroupName="Theme" Content="暗夜" IsChecked="True" Checked="Theme_Checked"/>
                                            <RadioButton x:Name="ThemeNeon" Style="{StaticResource Pill}" GroupName="Theme" Content="霓虹" Checked="Theme_Checked"/>
                                            <RadioButton x:Name="ThemeMinimal" Style="{StaticResource Pill}" GroupName="Theme" Content="极简白" Checked="Theme_Checked"/>
                                        </StackPanel>
                                        <TextBlock Text="亮度" Style="{StaticResource H2}" Margin="0,16,0,0"/>
                                        <Slider x:Name="BrightnessSlider2" Minimum="0" Maximum="255" Value="170" Margin="0,2,0,0" ValueChanged="BrightnessSlider2_ValueChanged"/>
                                        <TextBlock x:Name="BrightnessValue2Text" Text="170" Style="{StaticResource Caption}"/>
                                        <TextBlock Text="刷新间隔" Style="{StaticResource H2}" Margin="0,14,0,0"/>
                                        <Slider x:Name="IntervalSlider2" Minimum="1" Maximum="10" Value="3" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,2,0,0" ValueChanged="IntervalSlider2_ValueChanged"/>
                                        <TextBlock x:Name="IntervalValue2Text" Text="3 秒" Style="{StaticResource Caption}"/>
                                        <TextBlock Text="JPEG 质量" Style="{StaticResource H2}" Margin="0,14,0,0"/>
                                        <Slider x:Name="QualitySlider" Minimum="25" Maximum="95" Value="40" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,2,0,0" ValueChanged="QualitySlider_ValueChanged"/>
                                        <TextBlock x:Name="QualityValueText" Text="40" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="屏幕旋转" Style="{StaticResource H2}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <RadioButton x:Name="Rotate0" Style="{StaticResource Pill}" GroupName="Rotate" Content="0°" IsChecked="True" Checked="Rotate_Checked"/>
                                            <RadioButton x:Name="Rotate90" Style="{StaticResource Pill}" GroupName="Rotate" Content="90°" Checked="Rotate_Checked"/>
                                            <RadioButton x:Name="Rotate180" Style="{StaticResource Pill}" GroupName="Rotate" Content="180°" Checked="Rotate_Checked"/>
                                            <RadioButton x:Name="Rotate270" Style="{StaticResource Pill}" GroupName="Rotate" Content="270°" Checked="Rotate_Checked"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="播放屏内视频" Style="{StaticResource H2}"/>
                                        <TextBlock Text="设备 SD 卡中已有的视频，例如 /mnt/SDCARD/video/4_90.mp4" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                        <TextBox x:Name="VideoPathBox" Margin="0,8,0,0" Text="/mnt/SDCARD/video/4_90.mp4"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Style="{StaticResource PrimaryButton}" Content="播放视频" Click="BtnPlayVideo_Click"/>
                                            <Button Style="{StaticResource GhostButton}" Content="返回仪表盘" Margin="8,0,0,0" Click="BtnBackToImage_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Settings -->
                <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="服务与设置" Style="{StaticResource H1}"/>
                        <TextBlock Text="服务在开机时静默运行，不依赖登录界面。" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="后台服务" Style="{StaticResource H2}"/>
                                    <TextBlock x:Name="ServiceStateText" Text="未检测到服务（当前为本地模式）" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="ServiceDetailText" Text="" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnInstallService" Style="{StaticResource PrimaryButton}" Content="安装并启动服务" Click="BtnInstallService_Click"/>
                                    <Button x:Name="BtnUninstallService" Style="{StaticResource GhostButton}" Content="卸载服务" Margin="8,0,0,0" Click="BtnUninstallService_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="连接" Style="{StaticResource H2}"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="200"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="串口" VerticalAlignment="Center" Style="{StaticResource Caption}"/>
                                    <TextBox x:Name="PortBox" Grid.Column="1" Text="自动检测"/>
                                    <TextBlock Grid.Column="2" Text="留空或“自动检测”表示按 VID/PID 查找" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="界面与单位" Style="{StaticResource H2}"/>
                                <CheckBox x:Name="FahrenheitCheck" Content="华氏度" Foreground="{StaticResource Text}" FontSize="13" Margin="0,10,0,0"/>
                                <CheckBox x:Name="StartMinimizedCheck" Content="启动时最小化到托盘" Foreground="{StaticResource Text}" FontSize="13" Margin="0,8,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" Content="保存设置" Click="BtnSaveSettings_Click"/>
                                    <Button Style="{StaticResource GhostButton}" Content="打开服务日志" Margin="8,0,0,0" Click="BtnOpenLog_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="关于" Style="{StaticResource H2}"/>
                                <TextBlock Text="SAMA Display 是面向先马（SAMA）水冷屏的原生 WPF 替代前端，使用 .NET 8 与 WPF 原生控件重写。" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="显示协议：USB CDC 115200 8N1 · 250 字节定长包 · EF 69 魔数 · JPEG 全帧推送。" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="AboutStatusText" Text="" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
